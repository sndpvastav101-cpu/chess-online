# Copy this file to ".env" (same folder) before running the app.
# .env is a secret file - never share it or upload it anywhere public.

# Any long random text works. This is used to sign login sessions.
JWT_SECRET=change_this_to_any_long_random_text_123456

# Port the website will run on (http://localhost:PORT)
PORT=3000

# Optional: enables the "Sign in with Google" button.
# Leave blank to skip Google sign-in and use email/password only.
# See README.md section "Setting up Google Sign-In" for how to get this.
GOOGLE_CLIENT_ID=
